{
  "manifest_version": 3,
  "name": "Escritor automático — puente web (Chrome, Edge y Brave)",
  "version": "1.3.0",
  "description": "Extensión compatible con navegadores Chromium. Conecta con Escritor automático para detectar campos web y escribir progresivamente con escaneo y memoria optimizados.",
  "permissions": [
    "tabs",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Escritor automático — sincronizar pestañas",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
